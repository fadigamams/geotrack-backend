# Render fournit DATABASE_URL automatiquement si tu lies une base PostgreSQL au service.
DATABASE_URL=postgresql://user:password@host:5432/geotrack

# Secret utilisé pour signer les tokens JWT — génère une valeur longue et aléatoire en production.
JWT_SECRET=change-moi-en-production

# Durée de validité du token d'accès
JWT_EXPIRES_IN=7d

# Origine(s) autorisée(s) pour le frontend (CORS). Plusieurs origines séparées par une virgule.
CORS_ORIGIN=http://localhost:5500

PORT=3000
NODE_ENV=production
